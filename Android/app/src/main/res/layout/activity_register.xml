<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="40dp">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Chấm Điểm Tự Động"
        android:textColor="#007BFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtHoTen"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:background="@null"
        android:hint="Họ và Tên"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:inputType="text"
        android:textColorHint="#A8A8A8" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC" />
    <EditText
        android:id="@+id/edtTenTaiKhoan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:background="@null"
        android:hint="Tên đăng nhập"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:inputType="text"
        android:textColorHint="#A8A8A8" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC" />

    <EditText
        android:id="@+id/edtMatKhau"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@null"
        android:hint="Mật khẩu"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:inputType="textPassword"
        android:textColorHint="#A8A8A8" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC" />

    <EditText
        android:id="@+id/edtXacNhanMatKhau"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@null"
        android:hint="Xác Nhận Mật khẩu"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:inputType="textPassword"
        android:textColorHint="#A8A8A8" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC" />
    <Button
        android:id="@+id/btnDoRegister"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#00CCFF"
        android:text="Đăng ký"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

</LinearLayout>